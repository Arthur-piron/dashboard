# Copy to .env and fill in what you need. Every variable is optional for a local run:
# an empty value falls back to the local default set in docker-compose.yml.

# Database password (PostgreSQL container).
POSTGRES_PASSWORD=
# JWT signing key. Generate one with: openssl rand -base64 48
JWT_KEY=
# Public URL of the web client, used in confirmation and OAuth redirect links.
FRONTEND_URL=
# Development or Production.
ASPNETCORE_ENVIRONMENT=
# Email of the account that gets the administrator role.
ADMIN_EMAIL=

# GitHub service: an OAuth App (github.com/settings/developers).
# Callback: <FRONTEND_URL>/api/services/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Sign in with Google: an OAuth client of type "Web application" (console.cloud.google.com).
# Callback: <FRONTEND_URL>/api/auth/oidc/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Sign in with Microsoft: an Entra app registration (portal.azure.com), platform "Web".
# Callback: <FRONTEND_URL>/api/auth/oidc/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=
# Directory (tenant) id, or "common" if the app registration is multi-tenant.
MICROSOFT_TENANT=
